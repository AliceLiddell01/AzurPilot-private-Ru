logging {
  level  = "info"
  format = "logfmt"
}

otelcol.receiver.otlp "local" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    metrics = [otelcol.processor.batch.local.input]
    logs    = [otelcol.processor.batch.local.input]
    traces  = [otelcol.processor.batch.local.input]
  }
}

otelcol.processor.batch "local" {
  timeout             = "2s"
  send_batch_size     = 128
  send_batch_max_size = 512

  output {
    metrics = [otelcol.processor.transform.metrics.input]
    logs    = [otelcol.exporter.otlphttp.loki.input]
    traces  = [otelcol.exporter.otlphttp.tempo.input]
  }
}

otelcol.processor.transform "metrics" {
  error_mode = "ignore"

  metric_statements {
    context = "datapoint"

    statements = [
      `set(attributes["service.name"], resource.attributes["service.name"]) where resource.attributes["service.name"] != nil`,
      `set(attributes["deployment.environment.name"], resource.attributes["deployment.environment.name"]) where resource.attributes["deployment.environment.name"] != nil`,
    ]
  }

  output {
    metrics = [otelcol.exporter.prometheus.local.input]
  }
}

otelcol.exporter.prometheus "local" {
  forward_to = [prometheus.remote_write.local.receiver]
  include_scope_info = false
  include_scope_labels = false
  include_target_info = false
  resource_to_telemetry_conversion = false
}

prometheus.remote_write "local" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }

  wal {
    truncate_frequency = "2h"
    min_keepalive_time  = "5m"
    max_keepalive_time  = "8h"
  }
}

otelcol.exporter.otlphttp "loki" {
  client {
    endpoint = "http://loki:3100/otlp"
  }

  // Ограничение serialized bytes не зависит от размера отдельного batch.
  sending_queue {
    enabled           = true
    sizer             = "bytes"
    queue_size        = 16777216
    num_consumers     = 2
    block_on_overflow = false
  }

  retry_on_failure {
    enabled          = true
    initial_interval = "5s"
    max_interval     = "30s"
    max_elapsed_time = "5m"
  }
}

otelcol.exporter.otlphttp "tempo" {
  client {
    endpoint = "http://tempo:4318"
  }

  sending_queue {
    enabled           = true
    sizer             = "bytes"
    queue_size        = 16777216
    num_consumers     = 2
    block_on_overflow = false
  }

  retry_on_failure {
    enabled          = true
    initial_interval = "5s"
    max_interval     = "30s"
    max_elapsed_time = "5m"
  }
}
