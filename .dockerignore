# Пользовательские секреты и локальные учётные данные никогда не входят в
# контекст сборки корня репозитория. Подключение во время запуска выполняет
# типизированный Docker-сервис.
.env
.env.*
*.env
**/*.env
**/.env.*
.azurpilot-runtime.env
**/.azurpilot-runtime.env
!.env.example
!.env.template
